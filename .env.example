# Production single-user deployment
HOST=0.0.0.0
PORT=8787
SERVE_WEB=1
DATA_DIR=/app/data
# Set these to the exact public host used by your private tunnel or reverse proxy.
PUBLIC_ORIGIN=https://app.example.com
# Run npm run set-password before remote startup (stores salted hash in data/access.json).
# AUTH_FILE=/app/data/access.json
# BACKUP_DIR=/app/data/backups
# Optional mounted offsite directory for daily encrypted full snapshots (30 retained).
# FULL_BACKUP_DIR=/mnt/evidence-backups
# Provide EVIDENCE_BACKUP_PASSPHRASE via a protected service environment, never commit it.

# Optional outbound proxy for model providers
# HTTPS_PROXY=http://127.0.0.1:7890
