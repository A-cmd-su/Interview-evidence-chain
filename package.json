{
  "name": "interview-evidence-chain",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "node scripts/check-start.mjs",
    "dev": "concurrently --kill-others \"npm run server\" \"npm run dev:web\"",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/index.mjs",
    "dev:all": "npm run dev",
    "test": "node --test tests/*.test.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "format:check": "prettier --check src server shared tests scripts docs .github package.json vite.config.js playwright.config.mjs README.md",
    "format": "prettier --write src server shared tests scripts docs .github package.json vite.config.js playwright.config.mjs README.md",
    "test:browser": "playwright test",
    "check": "npm run format:check && npm test && npm run build && npm run test:browser"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "concurrently": "^10.0.5",
    "prettier": "^3.9.6",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "lucide-react": "^1.44.0",
    "mammoth": "^1.12.2",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tesseract.js": "^7.0.0"
  }
}
