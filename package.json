{
  "name": "interview-evidence-chain",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others \"npm run server\" \"npm run dev:web\"",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/index.mjs",
    "dev:all": "npm run dev",
    "test": "node --test tests/*.test.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 5173"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
